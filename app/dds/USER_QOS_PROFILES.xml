<?xml version="1.0"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/current/rti_dds_qos_profiles.xsd">

    <!-- QoS Library containing the QoS profiles -->
    <qos_library name="MissionManager_QOS_Library">

        <!-- Periodic QoS Profile -->
        <qos_profile name="Periodic" base_name="BuiltinQosLibExp::Generic.BestEffort">
            <datareader_qos>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <subscription_name>
                    <name>PeriodicDataReader</name>
                </subscription_name>
            </datareader_qos>
            <datawriter_qos>
                <durability>
                    <kind>VOLATILE_DURABILITY_QOS</kind>
                </durability>
                <publication_name>
                    <name>PeriodicDataWriter</name>
                </publication_name>
            </datawriter_qos>
            <domain_participant_qos>
                <participant_name>
                    <name>PeriodicParticipant</name>
                </participant_name>
            </domain_participant_qos>
        </qos_profile>

        <!-- Trigger QoS Profile -->
        <qos_profile name="Trigger" base_name="BuiltinQosLibExp::Generic.KeepLastReliable.TransientLocal">
            <datareader_qos>
                <subscription_name>
                    <name>TriggerDataReader</name>
                </subscription_name>
            </datareader_qos>
            <datawriter_qos>
                <publication_name>
                    <name>TriggerDataWriter</name>
                </publication_name>
            </datawriter_qos>
            <domain_participant_qos>
                <participant_name>
                    <name>TriggerParticipant</name>
                </participant_name>
            </domain_participant_qos>
        </qos_profile>

        <!-- Event QoS Profile -->
        <qos_profile name="Event" base_name="BuiltinQosLibExp::Pattern.Event">
            <base_name>
                <element>BuiltinQosSnippetLib::QosPolicy.Durability.TransientLocal</element>
            </base_name>
            <datareader_qos>
                <subscription_name>
                    <name>EventDataReader</name>
                </subscription_name>
            </datareader_qos>
            <datawriter_qos>
                <publication_name>
                    <name>EventDataWriter</name>
                </publication_name>
            </datawriter_qos>
            <domain_participant_qos>
                <participant_name>
                    <name>EventParticipant</name>
                </participant_name>
            </domain_participant_qos>
        </qos_profile>

        <!-- LargeEvent QoS Profile -->
        <qos_profile name="LargeEvent" base_name="BuiltinQosLibExp::Pattern.Event">
            <datawriter_qos>
                <publication_name>
                    <name>LargeEventDataWriter</name>
                </publication_name>
                <resource_limits>
                    <max_samples>32</max_samples>
                    <max_samples_per_instance>1</max_samples_per_instance>
                    <initial_samples>1</initial_samples>
                </resource_limits>
                <property>
                    <value>
                        <element>
                            <name>dds.data_writer.history.memory_manager.fast_pool.pool_buffer_max_size</name>
                            <value>0</value>
                        </element>
                    </value>
                </property>
            </datawriter_qos>
            <datareader_qos>
                <subscription_name>
                    <name>LargeEventDataReader</name>
                </subscription_name>
            </datareader_qos>
            <domain_participant_qos>
                <participant_name>
                    <name>LargeEventParticipant</name>
                </participant_name>
            </domain_participant_qos>
        </qos_profile>

        <!-- FileTransfer QoS Profile -->
        <qos_profile name="FileTransfer" base_name="BuiltinQosLibExp::Generic.KeepLastReliable.LargeData">
            <participant_qos>
                <resource_limits>
                    <type_code_max_serialized_length>8192</type_code_max_serialized_length>
                    <type_object_max_serialized_length>33554432</type_object_max_serialized_length>
                </resource_limits>
            </participant_qos>
            <datareader_qos>
                <subscription_name>
                    <name>FileTransferDataReader</name>
                </subscription_name>
            </datareader_qos>
            <datawriter_qos>
                <publication_name>
                    <name>FileTransferDataWriter</name>
                </publication_name>
            </datawriter_qos>
            <domain_participant_qos>
                <participant_name>
                    <name>FileTransferParticipant</name>
                </participant_name>
            </domain_participant_qos>
        </qos_profile>

    </qos_library>
</dds>